<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>



        <record id="library_member_view_tree" model="ir.ui.view">
            <field name="name">library.member.tree</field>
            <field name="model">library.member</field>
            <field name="arch" type="xml">
                <tree string="Members"
                      decoration-danger="status == 'suspended'"
                      decoration-muted="status == 'expired'">

                    <field name="membership_id"/>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="membership_type"/>
                    <field name="current_borrowed"/>
                    <field name="max_books"/>
                    <field name="fine_amount"/>
                    <field name="status"/>

                </tree>
            </field>
        </record>




        <record id="library_member_view_form" model="ir.ui.view">
            <field name="name">library.member.form</field>
            <field name="model">library.member</field>
            <field name="arch" type="xml">

                <form string="Member">


                    <header>
                        <field name="status"
                               widget="statusbar"
                               statusbar_visible="active,suspended,expired"/>
                    </header>


                    <sheet>



                        <div class="oe_button_box" name="button_box">


                            <button class="oe_stat_button"
                                    type="object"
                                    name="action_view_borrowings"
                                    icon="fa-book">

                                <field name="current_borrowed"
                                       widget="statinfo"
                                       string="Current Borrowed"/>

                            </button>



                            <button class="oe_stat_button"
                                    type="object"
                                    name="action_view_fines"
                                    icon="fa-money">

                                <field name="fine_amount"
                                       widget="statinfo"
                                       string="Total Fines"/>

                            </button>

                        </div>




                        <div class="oe_title">

                            <h1>
                                <field name="name"
                                       placeholder="Member Name"/>
                            </h1>

                            <field name="membership_id"
                                   readonly="1"/>

                        </div>




                        <notebook>

                            <!-- MEMBER INFO -->
                            <page string="Info">

                                <group>

                                    <group>
                                        <field name="email"/>
                                        <field name="phone"/>
                                        <field name="membership_date"/>
                                    </group>

                                    <group>
                                        <field name="membership_type"/>
                                        <field name="max_books"
                                               readonly="1"/>
                                        <field name="user_id"/>
                                    </group>

                                </group>

                            </page>


                            <!-- BORROWINGS -->
                            <page string="Borrowings">

                                <field name="borrowing_ids"
                                       readonly="1">

                                    <tree>

                                        <field name="book_id"/>
                                        <field name="borrow_date"/>
                                        <field name="due_date"/>
                                        <field name="return_date"/>
                                        <field name="status"/>
                                        <field name="fine_amount"/>

                                    </tree>

                                </field>

                            </page>


                            <!-- FINES -->
                            <page string="Fines">

                                <group>

                                    <field name="fine_amount"/>

                                </group>

                            </page>

                        </notebook>

                    </sheet>

                </form>

            </field>
        </record>




        <record id="library_member_view_search" model="ir.ui.view">

            <field name="name">library.member.search</field>
            <field name="model">library.member</field>

            <field name="arch" type="xml">

                <search string="Search Members">

                    <field name="name"/>
                    <field name="email"/>
                    <field name="membership_id"/>



                    <filter string="Active"
                            name="filter_active"
                            domain="[('status', '=', 'active')]"/>



                    <filter string="Suspended"
                            name="filter_suspended"
                            domain="[('status', '=', 'suspended')]"/>



                    <group expand="0"
                           string="Group By">

                        <filter string="Membership Type"
                                name="group_type"
                                context="{'group_by': 'membership_type'}"/>

                        <filter string="Status"
                                name="group_status"
                                context="{'group_by': 'status'}"/>

                    </group>

                </search>

            </field>
        </record>




        <record id="library_member_action_view"
                model="ir.actions.act_window">

            <field name="name">Members</field>
            <field name="res_model">library.member</field>
            <field name="view_mode">tree,form</field>

        </record>



        <record id="action_wizard_send_reminder_from_members"
                model="ir.actions.act_window">

            <field name="name">Send Reminder</field>
            <field name="res_model">wizard.send.reminder</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>

            <field name="binding_model_id"
                   ref="model_library_member"/>

            <field name="binding_view_types">list</field>

        </record>

    </data>
</odoo>