<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <record id="view_wizard_return_book_form" model="ir.ui.view">
            <field name="name">wizard.return.book.form</field>
            <field name="model">wizard.return.book</field>
            <field name="arch" type="xml">
                <form string="Return Book">
                    <group>
                        <field name="borrowing_id" readonly="1"/>
                        <field name="return_date"/>
                    </group>
                    <footer>
                        <button name="action_confirm_return"
                                string="Confirm Return"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wizard_return_book" model="ir.actions.act_window">
            <field name="name">Return Book</field>
            <field name="res_model">wizard.return.book</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>


        <record id="view_wizard_send_reminder_form" model="ir.ui.view">
            <field name="name">wizard.send.reminder.form</field>
            <field name="model">wizard.send.reminder</field>
            <field name="arch" type="xml">
                <form string="Send Reminder">
                    <group>
                        <field name="member_ids" widget="many2many_tags"/>
                        <field name="message"/>
                    </group>
                    <footer>
                        <button name="action_send_email"
                                string="Send Email"
                                type="object"
                                class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_wizard_send_reminder" model="ir.actions.act_window">
            <field name="name">Send Reminder</field>
            <field name="res_model">wizard.send.reminder</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>