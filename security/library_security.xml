<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">


        <record id="module_category_library" model="ir.module.category">
            <field name="name">Library</field>
            <field name="description">Manage library books, members and borrowings.</field>
            <field name="sequence">20</field>
        </record>


        <record id="group_library_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_library"/>
            <field name="comment">Basic library member - can view books and their own records.</field>
        </record>

        <record id="group_library_librarian" model="res.groups">
            <field name="name">Librarian</field>
            <field name="category_id" ref="module_category_library"/>
            <field name="implied_ids" eval="[(4, ref('group_library_user'))]"/>
            <field name="comment">Can manage books, members and borrowings.</field>
        </record>

        <record id="group_library_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_library"/>
            <field name="implied_ids" eval="[(4, ref('group_library_librarian'))]"/>
            <field name="comment">Full access including reports and configuration.</field>
        </record>



        <record id="rule_library_member_self" model="ir.rule">
            <field name="name">Library Member: Self Only</field>
            <field name="model_id" ref="model_library_member"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_library_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_library_member_all" model="ir.rule">
            <field name="name">Library Member: All (Librarian/Manager)</field>
            <field name="model_id" ref="model_library_member"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_library_librarian'))]"/>
        </record>

        <record id="rule_library_borrowing_self" model="ir.rule">
            <field name="name">Library Borrowing: Self Only</field>
            <field name="model_id" ref="model_library_borrowing"/>
            <field name="domain_force">[('member_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_library_user'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_library_borrowing_all" model="ir.rule">
            <field name="name">Library Borrowing: All (Librarian/Manager)</field>
            <field name="model_id" ref="model_library_borrowing"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_library_librarian'))]"/>
        </record>



    </data>
</odoo>